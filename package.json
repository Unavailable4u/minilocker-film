{
  "name": "minilocker-film",
  "version": "0.1.0",
  "private": true,
  "description": "Code-driven Remotion film for MiniLocker (Vultr Agent Rush, Challenge 1: Blast Radius Zero). 5100 frames, 1920x1080, 30 fps.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "studio:light": "remotion studio src/index.light.ts",
    "typecheck": "tsc --noEmit",
    "assets": "node scripts/fetch-assets.mjs",
    "evidence": "node scripts/capture-evidence.mjs",
    "evidence:check": "node scripts/validate-evidence.mjs",
    "evidence:final-check": "node scripts/validate-evidence.mjs --final",
    "proof": "node scripts/check-proof.mjs",
    "sfx": "node scripts/make-sfx.mjs",
    "sfx:check": "node scripts/make-sfx.mjs --check",
    "check": "node scripts/check-stills.mjs",
    "check:light": "node scripts/check-stills.mjs --theme=light",
    "motion": "node tools/audit-motion.mjs",
    "sheets": "node scripts/make-sheets.mjs",
    "render": "node scripts/render.mjs",
    "render:light": "node scripts/render.mjs --theme=light",
    "render:4k": "node scripts/render.mjs --4k",
    "render:light:4k": "node scripts/render.mjs --4k --theme=light",
    "render:frames": "node scripts/render.mjs --frames",
    "submission": "node scripts/make-submission-assets.mjs",
    "deck": "node scripts/make-deck.mjs",
    "deck:hd": "node scripts/make-deck.mjs --scale=2"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.540",
    "@remotion/cli": "4.0.540",
    "@remotion/renderer": "4.0.540",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.540"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "pdf-lib": "^1.17.1",
    "typescript": "5.9.3"
  }
}
